{
  "version": 2,
  "builds": [
    {
      "src": "app.py",
      "use": "@vercel/python"
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "app.py"
    }
  ],
  "env": {
    "PYTHONPATH": "."
  },
  "includeFiles": [
    "app.py",
    "requirements.txt",
    "app/**/*.py",
    "config/**/*.py",
    "common/**/*.py",
    "etl/common/**/*.py",
    "etl/amenities/**/*.py",
    "etl/pub/**/*.py",
    "etl/onemap/**/*.py",
    "etl/historical_floods/**/*.py",
    "etl/*.py",
    "etl/roadnetwork/**/*.py"
  ]
}
