{
  "version": 2,
  "framework": "fastapi",
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "crons": [
    {
      "path": "/api/weather-alerts/cron/recent-messages",
      "schedule": "* * * * *"
    }
  ],
  "builds": [
    {
      "src": "app.py",
      "use": "@vercel/python"
    }
  ],
  "routes": [
    {
      "src": "app/(.*)",
      "dest": "/app/app.py"
    }
  ]
}
